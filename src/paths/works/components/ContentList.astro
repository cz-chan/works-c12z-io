---
import styles from "@works-path/components/content-list.module.css";

export interface ContentListItem {
	title: string;
	href: string;
	subtitle?: string;
	meta?: string;
}

interface Props {
	items: ContentListItem[];
	title?: string;
	titleAs?: "h1" | "h2";
}

const { items, title, titleAs: Title = "h2" } = Astro.props;
---

<section>
	{
		title && (
			<Title
				class={styles.title}
				lang="en"
			>
				{title}
			</Title>
		)
	}

	<ul
		class={styles.list}
		role="list"
	>
		{
			items.map((item) => {
				const { href, title, meta, subtitle } = item;

				return (
					<li class={styles.item}>
						<a
							href={href}
							class={styles.entry}
						>
							<span class={styles.entryText}>
								<p class={styles.company}>{title}</p>
								{subtitle && (
									<span class={styles.entrySubtitle}>{subtitle}</span>
								)}
							</span>
							{meta && <span class={styles.entryMeta}>{meta}</span>}
						</a>
					</li>
				);
			})
		}
	</ul>
</section>

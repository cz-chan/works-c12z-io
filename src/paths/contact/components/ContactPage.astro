---
import styles from "@contact-path/components/contact.module.css";
import Form from "@contact-path/components/form/Form.astro";
import CopyEmail from "./copy-email/CopyEmail.astro";
---

<section class={styles.section}>
	<h1>let's talk</h1>

	<Form />

	<p class={styles.disclaimer}>
		if you'd prefer, you can contact me on your own by clicking on the email
		address to copy it: <CopyEmail />
	</p>
</section>

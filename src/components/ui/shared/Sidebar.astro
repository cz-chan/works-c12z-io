---
import styles from "./sidebar.module.css";

import { homeLinks } from "@global/home-links.ts";
---

<header class={`${styles.sidebar} w-invert`}>
	<section class={styles.identity}>
		<p class={styles.presentation}>chema ferrández - cz</p>
		<p class={styles.intro}>
			code builds products. growth brings users. behavior makes them work. i
			combine all three, with critical thinking, to scale products and revenue.
		</p>
		<p class={styles.intro}>
			i'm a growth product engineer based in Spain, willing to travel.
		</p>
	</section>

	<nav class={styles.nav}>
		<ul
			class={styles.navList}
			role="list"
		>
			{
				homeLinks.map((link) => (
					<li class={styles.navItem}>
						<a
							class={styles.navLink}
							href={link.href}
						>
							{link.label}
						</a>
						<span class={styles.navNote}>{link.note}</span>
					</li>
				))
			}
		</ul>
	</nav>

	<a
		class={styles.gocz}
		href="https://c12z.io"
		target="_blank"
		rel="noopener noreferrer"
		>go to blog</a
	>
</header>

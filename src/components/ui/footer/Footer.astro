---
import styles from "@ui/footer/footer.module.css";

interface Props {
	note?: string;
	since?: number;
}

const { note = "thanks for looking.", since = 2024 } = Astro.props;

const currentYear = new Date().getFullYear();
const years = since === currentYear ? `${since}` : `${since}—${currentYear}`;
---

<footer class={styles.footer}>
	<p class={styles.line}>{note}</p>
	<p class={styles.line}>
		{years} · <a href="/contact">let's work together</a>
	</p>
</footer>

---
import { ClientRouter } from "astro:transitions";
import Favicons from "@seo/Favicons.astro";
---

<head>
	<ClientRouter />
	<Favicons />

	<!-- <GA4 />
	<GTMHead />
	<AhrefsAnalytics />
	<Overtracking /> -->

	<link
		rel="preload"
		as="font"
		href="/fonts/NectoMono-Regular.woff2"
		type="font/woff2"
		crossorigin
	/>
	<link
		rel="preload"
		as="font"
		href="/fonts/NectoMono-Regular.woff"
		type="font/woff"
		crossorigin
	/>

	{/* Global Metadata */}
	<meta charset="UTF-8" />
	<meta
		content="IE=edge"
		http-equiv="X-UA-Compatible"
	/>
	<meta
		name="format-detection"
		content="telephone=no"
	/>
	<meta
		name="referrer"
		content="no-referrer-when-downgrade"
	/>
	<meta
		name="robots"
		content="index, follow"
	/>
	<meta
		name="viewport"
		content="width=device-width, initial-scale=1.0, user-scalable=yes, shrink-to-fit=no"
	/>
	<meta
		name="generator"
		content={Astro.generator}
	/>

	<link
		rel="sitemap"
		href="/sitemap-index.xml"
	/>

	<slot />
</head>

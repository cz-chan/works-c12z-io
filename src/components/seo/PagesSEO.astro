---
interface Props {
	pageTitle: string;
	pageDescription: string;
	ogImage?: string;
	ogImageAlt?: string;
}

const { pageTitle, pageDescription, ogImage, ogImageAlt } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const ogImageUrl = ogImage
	? new URL(ogImage, Astro.site)
	: new URL("./og-image.webp", Astro.site);
const ogImageUrlAlt = ogImageAlt || pageTitle;
---

<title>{pageTitle}</title>

<meta
	content={pageTitle}
	name="title"
/>
<meta
	name="description"
	content={pageDescription}
/>
<meta
	content="chema ferrández"
	name="author"
/>

<link
	rel="canonical"
	href={canonicalURL}
/>

{/* Open Graph / Facebook / WhatsApp */}
<meta
	property="og:title"
	content={pageTitle}
/>
<meta
	property="og:url"
	content={canonicalURL}
/>
<meta
	property="og:description"
	content={pageDescription}
/>
<meta
	content="works.c12z.io"
	property="og:site_name"
/>

<meta
	property="og:image"
	content={ogImageUrl}
/>
<meta
	property="og:image:alt"
	content={ogImageUrlAlt}
/>
<meta
	property="og:image:width"
	content="1200"
/>
<meta
	property="og:image:height"
	content="630"
/>
<meta
	property="og:locale"
	content="en_US"
/>

<meta
	property="fb:app_id"
	content="1548538199200247"
/>

<meta
	property="og:type"
	content="website"
/>

{/* Twitter */}
<meta
	name="twitter:title"
	content={pageTitle}
/>
<meta
	name="twitter:description"
	content={pageDescription}
/>
<meta
	name="twitter:image"
	content={ogImageUrl}
/>
<meta
	name="twitter:image:alt"
	content={ogImageUrlAlt}
/>
<meta
	name="twitter:card"
	content="summary_large_image"
/>
<meta
	name="twitter:site"
	content="@cz__chan"
/>
<meta
	name="twitter:creator"
	content="@cz__chan"
/>

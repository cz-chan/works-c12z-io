---
import "@styles/global.css";

import BaseHead from "@seo/BaseHead.astro";
import Sidebar from "@ui/shared/Sidebar.astro";
import Footer from "@ui/footer/Footer.astro";

interface Props {
	showFooter?: boolean;
}

const { showFooter = true } = Astro.props;
---

<!doctype html>
<html lang="en">
	<BaseHead>
		<slot name="head" />
	</BaseHead>
	<body>
		<Sidebar />
		<main>
			<slot />
			{showFooter && <Footer />}
		</main>
	</body>
</html>

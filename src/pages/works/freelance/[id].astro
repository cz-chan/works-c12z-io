---
import { getCollection } from "astro:content";

import { FREELANCE_ID, isChildOf } from "@utils/works.ts";

import MainLayout from "@layouts/MainLayout.astro";
import ContentSEO from "@seo/ContentSEO.astro";
import WorkDetail from "@works-path/components/WorkDetail.astro";

export async function getStaticPaths() {
	const projects = await getCollection("works", isChildOf(FREELANCE_ID));

	return projects.map((freelanceWork) => ({
		params: { id: freelanceWork.id.slice(FREELANCE_ID.length + 1) },
		props: { freelanceWork },
	}));
}

const { freelanceWork } = Astro.props;
---

<MainLayout>
	<ContentSEO
		slot="head"
		entry={freelanceWork}
	/>

	<WorkDetail
		backHref="/works/freelance"
		entry={freelanceWork}
	/>
</MainLayout>

---
import { getCollection, type CollectionEntry } from "astro:content";

import { FREELANCE_ID, isChildOf } from "@utils/works.ts";

import MainLayout from "@layouts/MainLayout.astro";
import WorkDetail from "@works-path/components/WorkDetail.astro";

export async function getStaticPaths() {
	const projects = await getCollection("works", isChildOf(FREELANCE_ID));

	return projects.map((work) => ({
		params: { id: work.id.slice(FREELANCE_ID.length + 1) },
		props: { work },
	}));
}

interface Props {
	work: CollectionEntry<"works">;
}

const { work } = Astro.props;
---

<MainLayout>
	<WorkDetail
		backHref="/works/freelance"
		entry={work}
	/>
</MainLayout>

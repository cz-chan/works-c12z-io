---
import { getCollection, type CollectionEntry } from "astro:content";

import { FREELANCE_ID, isChildOf } from "@utils/works.ts";

import MainLayout from "@layouts/MainLayout.astro";
import WorkDetail from "@works-path/components/WorkDetail.astro";
import ContentSEO from "@seo/ContentSEO.astro";

export async function getStaticPaths() {
	const projects = await getCollection("works", isChildOf(FREELANCE_ID));

	return projects.map((work) => ({
		params: { id: work.id.slice(FREELANCE_ID.length + 1) },
		props: { work },
	}));
}

interface Props {
	freelanceWorks: CollectionEntry<"works">;
}

const { freelanceWorks } = Astro.props;
---

<MainLayout>
	<ContentSEO
		slot="head"
		entry={freelanceWorks}
	/>
	<WorkDetail
		backHref="/works/freelance"
		entry={freelanceWorks}
	/>
</MainLayout>

---
import { getCollection } from "astro:content";

import { byRecency, isTopLevel, toContentListItems } from "@utils/works.ts";
import { PAGES } from "@global/pages-info.ts";

import MainLayout from "@layouts/MainLayout.astro";
import GoBack from "@ui/goback/GoBack.astro";
import ContentList from "@works-path/components/ContentList.astro";
import PagesSEO from "@seo/PagesSEO.astro";

const works = (await getCollection("works", isTopLevel)).sort(byRecency);

const WORK_PAGE = PAGES.works;
---

<MainLayout>
	<PagesSEO
		slot="head"
		pageTitle={WORK_PAGE.title}
		pageDescription={WORK_PAGE.description}
	/>
	<GoBack backHref="/" />

	<ContentList
		items={toContentListItems(works)}
		title={WORK_PAGE.heading}
		titleAs="h1"
	/>
</MainLayout>

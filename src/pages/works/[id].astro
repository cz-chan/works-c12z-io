---
import { getCollection, type CollectionEntry } from "astro:content";

import { isGenericWork } from "@utils/works.ts";

import MainLayout from "@layouts/MainLayout.astro";
import WorkDetail from "@works-path/components/WorkDetail.astro";
import ContentSEO from "@seo/ContentSEO.astro";

export async function getStaticPaths() {
	const works = await getCollection("works", isGenericWork);

	return works.map((work) => ({
		params: { id: work.id },
		props: { work },
	}));
}

interface Props {
	works: CollectionEntry<"works">;
}

const { works } = Astro.props;
---

<MainLayout>
	<ContentSEO
		slot="head"
		entry={works}
	/>
	<WorkDetail
		backHref="/works"
		entry={works}
	/>
</MainLayout>
